# --- Required before first start ---
# Default LLM: Groq (the configuration that was evaluated). Set GROQ_API_KEY (GROG_KEY is also accepted).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Fixed-rule scan skips negated matches when true. Default false (original scan: no misses, more false alarms).
RED_FLAG_NEGATION_CHECK=false
# Optional alternative: LLM_PROVIDER=gemini plus the Gemini key(s) below.
GEMINI_API_KEY=
# Optional extra keys: a long evaluation run continues on the next one when a key
# hits its per-day quota (free tier: 20 requests/day/model).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Must NOT stay as change-me-in-production (app refuses to boot).
JWT_SECRET=replace-with-a-long-random-string

GEMINI_MODEL=gemini-2.5-flash

# BAAI/bge-m3 — LangChain HuggingFaceEmbeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=auto
EMBEDDING_TRUST_REMOTE_CODE=true
EMBEDDING_NORMALIZE=true
EMBEDDING_MAX_SEQ_LENGTH=512
# Optional Hugging Face token (fewer rate-limit failures when downloading bge-m3)
HF_TOKEN=

# --- Compose project / published host ports (avoid 8000/8080/5432 clashes) ---
COMPOSE_PROJECT_NAME=contractlens
API_PORT=8010
FRONTEND_PORT=5173
POSTGRES_PORT=5433
NEO4J_BOLT_PORT=7688
# Keep 0 unless Docker Desktop RAM >= 8GB (reload + bge-m3 OOMs easily).
DEV_RELOAD=0

POSTGRES_USER=contractlens
POSTGRES_PASSWORD=contractlens
POSTGRES_DB=contractlens

# Host-side URL (tools on the host talking to published Postgres port).
# The api container overrides this to @postgres:5432 via docker-compose.
DATABASE_URL=postgresql://contractlens:contractlens@localhost:5433/contractlens

NEO4J_USER=neo4j
NEO4J_PASSWORD=contractlens
# Host-side Bolt URL. The api container overrides to bolt://neo4j:7687.
NEO4J_URI=bolt://localhost:7688

VITE_API_BASE_URL=http://localhost:8010
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
MAX_CHUNK_SIZE=1800
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.6

# GraphRAG hierarchy expand: neo4j | postgres | both
LEGAL_EXPAND_BACKEND=neo4j
RAG_LABOR_SCOPE=true

# --- LangSmith observability (tuỳ chọn) ---
# Chỉ cần điền LANGCHAIN_API_KEY để bật tracing; để trống nếu không dùng.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=contractlens
